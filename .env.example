# Optional. Defaults target XRPL Testnet (production-shape proof: only Mainnet-live transaction types).
XRPL_WSS=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER=https://testnet.xrpl.org
# Devnet is only for the compressed CI smoke run:
# XRPL_WSS=wss://s.devnet.rippletest.net:51233
# Reuse test-network wallets between runs (file is gitignored; test funds have no value).
# WALLETS_FILE=out/wallets.testnet.json

# --- v3 (Python engine, mortgageos/) ---
# Writer role on the councilforge database; the mortgageos schema is created on first run.
# COUNCILFORGE_DSN=postgresql://councilforge:<password>@100.126.131.8:5434/councilforge
# MOS_WALLETS_FILE=out/wallets.py.testnet.json
# MOS_COMPANY_ID=htm

# --- v4 (Mainnet) ---
# Mainnet spends REAL XRP and is irreversible. The engine refuses Mainnet endpoints unless the
# opt-in below is set verbatim. There is no faucet: run `python -m mortgageos.provision` to create
# the six role wallets and print the XRP each one still needs, fund them yourself, then re-run it
# to confirm before deploying.
# XRPL_WSS=wss://xrplcluster.com
# XRPL_EXPLORER=https://livenet.xrpl.org
# MOS_ALLOW_MAINNET=yes-real-xrp
# MOS_WALLETS_FILE defaults to out/wallets.py.mainnet.json on Mainnet. That file holds seeds that
# control real funds — it is gitignored; back it up offline and never commit or paste it.
