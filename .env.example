# Optional. Defaults target XRPL Devnet, the only public network where
# MPTokensV1 + SingleAssetVault + LendingProtocol are all enabled (checked 2026-09-04).
XRPL_WSS=wss://s.devnet.rippletest.net:51233
XRPL_EXPLORER=https://devnet.xrpl.org
# Reuse Devnet wallets between runs (file is gitignored; Devnet funds have no value).
WALLETS_FILE=out/wallets.json
