[
  {
    "id": "build-hooks",
    "execute-command": "/usr/local/bin/build-on-push.sh",
    "command-working-directory": "/work",
    "pass-arguments-to-command": [
      { "source": "payload", "name": "after" },
      { "source": "payload", "name": "ref" }
    ],
    "include-command-output-in-response": true,
    "trigger-rule": {
      "and": [
        { "match": { "type": "payload-hmac-sha256", "secret": "{{ getenv "WEBHOOK_SECRET" | js }}", "parameter": { "source": "header", "name": "X-Hub-Signature-256" } } },
        { "match": { "type": "value", "value": "refs/heads/v3", "parameter": { "source": "payload", "name": "ref" } } }
      ]
    }
  }
]
