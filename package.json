{
  "name": "xrpl-mortgage-tokenizing-htm",
  "version": "2.0.0",
  "description": "Residential mortgage servicing layer on the XRP Ledger: paper closing package -> canonical loan record -> 12 CFR 1024.17 escrow engine, Form 1098, and Mainnet-live XRPL primitives (Payment, NFToken record, TokenEscrow date locks) proven on Testnet. High Tech Mortgage, Inc.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/devnet/** --exclude tests/testnet/**",
    "test:devnet": "DEVNET=1 XRPL_WSS=wss://s.devnet.rippletest.net:51233 vitest run tests/devnet --testTimeout=300000",
    "export": "tsx src/cli/export.ts",
    "print": "tsx src/cli/print.ts",
    "scan": "tsx src/cli/scan.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:apply": "scripts/db-apply.sh",
    "db:record": "tsx src/db/record-run.ts",
    "tokenize": "tsx src/tokenize.ts",
    "signatures": "tsx src/cli/signatures.ts",
    "loan-year": "tsx src/loan-year.ts",
    "loan-year:replay": "tsx src/loan-year.ts --no-ledger",
    "evidence": "tsx src/cli/evidence-pack.ts",
    "test:testnet": "TESTNET=1 vitest run tests/testnet --testTimeout=600000"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "xrpl": "5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
